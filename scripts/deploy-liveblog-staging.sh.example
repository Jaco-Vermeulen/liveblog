#!/usr/bin/env bash
# =============================================================================
# Liveblog — one-shot staging deploy (Linux)
#
# 1. Copy this file on your server (any path), e.g. /root/deploy-liveblog.sh
# 2. Fill in the CONFIG section below (repo URL, host, keys, etc.)
# 3. chmod +x deploy-liveblog.sh && sudo ./deploy-liveblog.sh
#
# Do NOT commit your filled copy to git — it may contain secrets.
# =============================================================================
set -euo pipefail

# ─── CONFIG — edit these ─────────────────────────────────────────────────────

# Git (use HTTPS with token, or SSH URL if the server has a deploy key)
REPO_URL="https://github.com/Jaco-Vermeulen/liveblog.git"
BRANCH="master"
INSTALL_DIR="/opt/liveblog"

# Public hostname or IP users open in the browser (no trailing slash)
PUBLIC_HOST="staging.example.com"
USE_HTTPS="false"   # true if you terminate TLS in front (nginx/caddy); URLs use https/wss

# Leave empty to auto-build from PUBLIC_HOST + ports below; set to override
SUPERDESK_URL=""
SUPERDESK_WS_URL=""
SUPERDESK_CLIENT_URL=""

API_PORT="5000"
WS_PORT="5100"
UI_PORT="9000"

# App env (written to INSTALL_DIR/.env)
LIVEBLOG_DEBUG="true"
SUPERDESK_TESTING="true"
WEB_CONCURRENCY="1"
IFRAMELY_KEY="a5ee9a89addd13b7a2e3a48c23e74e8d"

# Optional — leave empty if unused
AMAZON_ACCESS_KEY_ID=""
AMAZON_SECRET_ACCESS_KEY=""
AMAZON_REGION=""
AMAZON_CONTAINER_NAME=""
SENTRY_DSN=""

# Install Docker + Compose plugin if missing (Ubuntu/Debian apt)
INSTALL_DOCKER="true"

# Re-clone from scratch when true (wipes INSTALL_DIR except ./data if you keep it)
FRESH_INSTALL="false"

# ─── end CONFIG ───────────────────────────────────────────────────────────────

log() { echo "[liveblog-deploy] $*"; }
die() { echo "[liveblog-deploy] ERROR: $*" >&2; exit 1; }

if [[ "${EUID}" -ne 0 ]]; then
  die "Run as root: sudo $0"
fi

install_docker() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    log "Docker and Compose plugin already installed"
    return
  fi
  [[ "${INSTALL_DOCKER}" == "true" ]] || die "Docker not found. Set INSTALL_DOCKER=true or install Docker manually."
  log "Installing Docker (apt)..."
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl git
  if ! command -v docker >/dev/null 2>&1; then
    curl -fsSL https://get.docker.com | sh
  fi
  apt-get install -y -qq docker-compose-plugin 2>/dev/null || true
  systemctl enable --now docker 2>/dev/null || true
  command -v docker >/dev/null 2>&1 || die "Docker install failed"
  docker compose version >/dev/null 2>&1 || die "docker compose plugin missing — install docker-compose-plugin"
}

build_public_urls() {
  local scheme ws_scheme
  if [[ "${USE_HTTPS}" == "true" ]]; then
    scheme="https"
    ws_scheme="wss"
  else
    scheme="http"
    ws_scheme="ws"
  fi
  if [[ -z "${SUPERDESK_URL}" ]]; then
    SUPERDESK_URL="${scheme}://${PUBLIC_HOST}:${API_PORT}/api"
  fi
  if [[ -z "${SUPERDESK_WS_URL}" ]]; then
    SUPERDESK_WS_URL="${ws_scheme}://${PUBLIC_HOST}:${WS_PORT}"
  fi
  if [[ -z "${SUPERDESK_CLIENT_URL}" ]]; then
    SUPERDESK_CLIENT_URL="${scheme}://${PUBLIC_HOST}:${UI_PORT}"
  fi
}

clone_or_update() {
  if [[ "${FRESH_INSTALL}" == "true" && -d "${INSTALL_DIR}/.git" ]]; then
    log "FRESH_INSTALL: removing ${INSTALL_DIR} (keeping data/ if present)..."
    if [[ -d "${INSTALL_DIR}/data" ]]; then
      mv "${INSTALL_DIR}/data" "/tmp/liveblog-data-backup-$$"
    fi
    rm -rf "${INSTALL_DIR}"
    mkdir -p "${INSTALL_DIR}"
    if [[ -d "/tmp/liveblog-data-backup-$$" ]]; then
      mv "/tmp/liveblog-data-backup-$$" "${INSTALL_DIR}/data"
    fi
  fi
  if [[ -d "${INSTALL_DIR}/.git" ]]; then
    log "Updating repo in ${INSTALL_DIR}..."
    git -C "${INSTALL_DIR}" fetch origin
    git -C "${INSTALL_DIR}" checkout "${BRANCH}"
    git -C "${INSTALL_DIR}" pull --ff-only origin "${BRANCH}"
  else
    log "Cloning ${REPO_URL} (branch ${BRANCH})..."
    mkdir -p "$(dirname "${INSTALL_DIR}")"
    git clone --branch "${BRANCH}" --depth 1 "${REPO_URL}" "${INSTALL_DIR}"
  fi
}

write_env_file() {
  local env_file="${INSTALL_DIR}/.env"
  log "Writing ${env_file}"
  cat > "${env_file}" <<EOF
# Generated by deploy-liveblog-staging.sh — $(date -u +%Y-%m-%dT%H:%M:%SZ)
SUPERDESK_URL=${SUPERDESK_URL}
SUPERDESK_WS_URL=${SUPERDESK_WS_URL}
SUPERDESK_CLIENT_URL=${SUPERDESK_CLIENT_URL}
LIVEBLOG_DEBUG=${LIVEBLOG_DEBUG}
SUPERDESK_TESTING=${SUPERDESK_TESTING}
WEB_CONCURRENCY=${WEB_CONCURRENCY}
IFRAMELY_KEY=${IFRAMELY_KEY}
EOF
  if [[ -n "${AMAZON_ACCESS_KEY_ID}" ]]; then
    cat >> "${env_file}" <<EOF
AMAZON_ACCESS_KEY_ID=${AMAZON_ACCESS_KEY_ID}
AMAZON_SECRET_ACCESS_KEY=${AMAZON_SECRET_ACCESS_KEY}
AMAZON_REGION=${AMAZON_REGION}
AMAZON_CONTAINER_NAME=${AMAZON_CONTAINER_NAME}
EOF
  fi
  if [[ -n "${SENTRY_DSN}" ]]; then
    echo "SENTRY_DSN=${SENTRY_DSN}" >> "${env_file}"
  fi
  chmod 600 "${env_file}"
}

wait_for_healthy() {
  local name="$1" max="${2:-120}" i=0
  log "Waiting for ${name} to be healthy (max ${max}s)..."
  while [[ $i -lt $max ]]; do
    if docker inspect --format='{{.State.Health.Status}}' "${name}" 2>/dev/null | grep -q healthy; then
      log "${name} is healthy"
      return 0
    fi
    if ! docker ps --format '{{.Names}}' | grep -qx "${name}"; then
      sleep 2
      i=$((i + 2))
      continue
    fi
    sleep 5
    i=$((i + 5))
  done
  log "WARN: ${name} not healthy yet — check: docker compose -f ${INSTALL_DIR}/docker-compose.yml logs ${name}"
}

run_compose() {
  cd "${INSTALL_DIR}"
  log "Building and starting containers (first run can take 15–30 min)..."
  docker compose up -d --build
  wait_for_healthy liveblog-server 180 || true
  wait_for_healthy liveblog-client 120 || true
}

print_summary() {
  cat <<EOF

================================================================================
Liveblog deploy finished
================================================================================
  Install dir:  ${INSTALL_DIR}
  UI:           ${SUPERDESK_CLIENT_URL}
  API:          ${SUPERDESK_URL}
  WebSocket:    ${SUPERDESK_WS_URL}
  Login:        admin / admin   (change after first login)

  Logs:         cd ${INSTALL_DIR} && docker compose logs -f
  Stop:         cd ${INSTALL_DIR} && docker compose down
  Re-seed DB:   cd ${INSTALL_DIR} && docker compose run --rm -e LIVEBLOG_FORCE_INIT=1 init
  Update:       edit this script CONFIG if needed, re-run, or: cd ${INSTALL_DIR} && git pull && docker compose up -d --build

  Open firewall ports if needed: ${UI_PORT} ${API_PORT} ${WS_PORT}
================================================================================
EOF
}

main() {
  [[ -n "${REPO_URL}" ]] || die "Set REPO_URL in CONFIG"
  [[ -n "${PUBLIC_HOST}" && "${PUBLIC_HOST}" != "staging.example.com" ]] || die "Set PUBLIC_HOST in CONFIG"
  install_docker
  build_public_urls
  clone_or_update
  write_env_file
  run_compose
  print_summary
}

main "$@"
