{
  "name": "liveblog-client-web2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modern Liveblog admin client — React, Vite, Tailwind (web2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:docker": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:auth": "node scripts/smoke-auth-no-password.mjs",
    "smoke:mail": "node scripts/smoke-mail-api.mjs",
    "smoke:api": "node scripts/smoke-auth-no-password.mjs && node scripts/smoke-blogs.mjs && node scripts/smoke-editor.mjs && node scripts/smoke-phase5.mjs && node scripts/smoke-websocket.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "launch:verify": "node scripts/launch-verify.mjs",
    "docs4:install": "npm install --prefix docs4",
    "docs4:start": "npm start --prefix docs4",
    "docs4:export": "npm run export --prefix docs4",
    "docs4:build": "npm run build --prefix docs4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-query-devtools": "^5.76.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "react-router-dom": "^7.6.0",
    "react-social-media-embed": "^2.5.18",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "volta": {
    "node": "20.19.1"
  }
}
