# Liveblog API (REST). Vite dev server proxies /api, /embed, /themes_assets, /themes_uploads to this host.
VITE_LIVEBLOG_API_URL=http://localhost:5000/api

# WebSocket (WAMP) — used in Phase 1+
VITE_LIVEBLOG_WS_URL=ws://localhost:5100

# Iframely public key (MD5 hash as key= on oEmbed + cdn.iframe.ly/embed.js — same as legacy/webpack)
# Default: a5ee9a89addd13b7a2e3a48c23e74e8d — override only if your Iframely account uses another key
# VITE_IFRAMELY_KEY=
# VITE_FACEBOOK_APP_ID=
# VITE_EMBED_COVER_MAX_WIDTH=350

# Google Fonts API key for theme style font picker (Styles tab)
# VITE_GOOGLE_FONTS_KEY=

# Phase 6 feature gates (match instance_settings / superdeskConfig)
# VITE_MARKETPLACE=true
# VITE_SYNDICATION=true

# Show post-launch expansion items in Admin nav (syndication, marketplace, advertising, freetypes)
# VITE_SHOW_EXPANSION_NAV=true
