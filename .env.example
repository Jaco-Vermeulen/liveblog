# Copy to `.env` — Docker Compose loads it automatically.
# Copy MAIL_* (and optional keys) from CONFIG in deploy-liveblog.sh or deploy-liveblog-light.sh

MAIL_SERVER=smtp.mandrillapp.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=Maroela Media
MAIL_PASSWORD=your-mandrill-api-key-from-deploy-script
MAIL_FROM=geen-antwoord@maroelamedia.co.za
MAIL_SUPPRESS_SEND=false

# Shown in password-reset e-mails (Afrikaans templates)
APP_NAME=Maroela Media Liveblog
EMAIL_LOGO_URL=https://mcusercontent.com/3d8f21b3e2/images/3a06e0a5-db1d-a4ea-cac2-8e87fb118fd0.png

IFRAMELY_KEY=a5ee9a89addd13b7a2e3a48c23e74e8d
SUPERDESK_CLIENT_URL=http://localhost:9001
