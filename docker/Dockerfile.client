# Liveblog client dev server (Node 10 — matches client/package.json volta)
FROM node:10-buster

ENV NODE_ENV=development \
    npm_config_loglevel=warn

# Buster is EOL — use Debian archive mirrors
RUN sed -i 's/deb.debian.org/archive.debian.org/g' /etc/apt/sources.list \
    && sed -i 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list \
    && sed -i '/buster-updates/d' /etc/apt/sources.list \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g grunt-cli@1.4.3

WORKDIR /opt/client

COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client/ /opt/client/
COPY docker/scripts/client-entrypoint.sh /docker/scripts/client-entrypoint.sh
RUN sed -i 's/\r$//' /docker/scripts/client-entrypoint.sh \
    && chmod +x /docker/scripts/client-entrypoint.sh

EXPOSE 9000 35729

ENTRYPOINT ["/bin/bash", "/docker/scripts/client-entrypoint.sh"]
