# Liveblog admin client — production static build (client_web2) served by nginx.
# Build: docker compose build client
# Dev hot-reload: docker/Dockerfile.client.dev (optional profile)

FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY client_web2/package.json client_web2/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY client_web2/ ./

# Same-origin paths — works behind host nginx or client nginx on :9000.
ARG VITE_LIVEBLOG_API_URL=/api
ARG VITE_LIVEBLOG_WS_URL=same-origin
ARG VITE_IFRAMELY_KEY=
ARG VITE_MARKETPLACE=
ARG VITE_SYNDICATION=

ENV VITE_LIVEBLOG_API_URL=${VITE_LIVEBLOG_API_URL} \
    VITE_LIVEBLOG_WS_URL=${VITE_LIVEBLOG_WS_URL} \
    VITE_IFRAMELY_KEY=${VITE_IFRAMELY_KEY} \
    VITE_MARKETPLACE=${VITE_MARKETPLACE} \
    VITE_SYNDICATION=${VITE_SYNDICATION}

RUN npm run build:docker

FROM nginx:1.27-alpine

COPY docker/nginx-client.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 9000

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=15s \
    CMD wget -qO- http://127.0.0.1:9000/ >/dev/null 2>&1 || exit 1
